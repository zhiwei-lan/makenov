# MAKENOV — 언어별 서브도메인 운영용 Nginx 설정 (1Panel 사이트 conf 의 server{} 안에 넣는다)
# ------------------------------------------------------------------------------------
# 호스트            언어     실제 폴더(public/ 기준)
#   vn.makenov.com   베트남어  /            (루트 파일)
#   kr.makenov.com   한국어    /ko/
#   en.makenov.com   영어      /en/
#   makenov.com      (bare)    페이지는 vn 으로 301, API·관리자·자산·인증파일은 그대로
#
# 전제:
#   1) DNS(카페24): vn / kr / en  A 레코드 → 서버 IP (makenov.com 과 동일)
#   2) 1Panel 사이트 > 도메인 에 vn.makenov.com, kr.makenov.com, en.makenov.com 추가
#   3) 1Panel SSL 재발급 — 네 이름(makenov.com, vn, kr, en) 모두 포함 (HTTP-01, DNS 가 먼저 살아 있어야 함)
#   4) 사이트 루트(root)는 기존처럼 .../index/public
#
# 아래 블록을 기존 server{} 의 `location /` 자리에 교체/추가. PHP location 은 기존 그대로 둔다.

    # ── 호스트 → 언어 폴더 ──────────────────────────────
    set $mk_dir "";
    if ($host = kr.makenov.com) { set $mk_dir /ko; }
    if ($host = en.makenov.com) { set $mk_dir /en; }

    # ── 검색엔진 소유확인 파일은 어느 호스트에서든 그대로 (bare 리다이렉트 예외) ──
    location = /google17861e0b4b6f5a98.html { try_files $uri =404; }
    location = /naver6bbd9863e5f526a16ff68dfcec96b5ef.html { try_files $uri =404; }

    # ── 관리자는 makenov.com 한 곳에서만 ──
    location ^~ /admin/ {
        if ($host != makenov.com) { return 301 https://makenov.com$request_uri; }
        try_files $uri ${uri}index.html /index.php?$query_string;
    }

    # ── 옛 경로(/ko/*, /en/*) → 언어 호스트로 영구 이동 (모든 호스트 공통) ──
    # try_files 가 내부적으로 /ko/... 파일을 찾는 건 이 location 을 거치지 않는다(외부 요청만 잡힘)
    # ?raw=1 이 붙으면 리다이렉트하지 않고 파일 그대로 (관리자 SEO 탭이 같은 origin 에서 원문을 읽는 용도)
    location ~ ^/ko/(.*)$ { if ($arg_raw = "") { return 301 https://kr.makenov.com/$1$is_args$args; } try_files $uri =404; }
    location ~ ^/en/(.*)$ { if ($arg_raw = "") { return 301 https://en.makenov.com/$1$is_args$args; } try_files $uri =404; }

    # ── 페이지 서빙 ──
    location / {
        # bare 도메인: 페이지만 vn 으로. (API /rest/v1 ... , /assets, /uploads, /rss.xml, /deploy-check 는 그대로)
        set $mk_bare 0;
        if ($host = makenov.com) { set $mk_bare 1; }
        if ($arg_raw != "")      { set $mk_bare 0; }   # ?raw=1 은 관리자 원문 읽기 — 리다이렉트 제외
        if ($mk_bare) {
            rewrite ^/$ https://vn.makenov.com/ permanent;
            rewrite ^/maker\.html$ https://kr.makenov.com/maker.html permanent;   # 공급사 안내(한국어 전용)는 kr 로
            rewrite ^/((products|companies|columns)/.*)$ https://vn.makenov.com/$1 permanent;
            rewrite ^/([A-Za-z0-9_-]+\.html)$ https://vn.makenov.com/$1 permanent;
        }
        # 언어 폴더 먼저, 없으면 루트(공용 assets 등), 그래도 없으면 CI4
        # ⚠ `$uri/` 형태(디렉터리→index 내부 리다이렉트)를 쓰지 않고, index.html 후보를 먼저 둔다:
        #    `/` 요청에서 `/ko/`(디렉터리)가 먼저 잡히면 index 모듈이 /ko/index.html 로 내부 리다이렉트하면서 위 301 에 걸린다
        try_files $mk_dir${uri}index.html $mk_dir$uri ${uri}index.html $uri /index.php?$query_string;
    }

# 참고:
#  - sitemap.xml / robots.txt 는 정적 파일을 지우고 CI4 라우트(App\Controllers\Api\Seo)가 호스트별로 낸다 → 위 try_files 의 마지막 fallback 으로 자연히 도달
#  - rss.xml 도 CI4 라우트. 어느 호스트에서든 동작
#  - 확인: curl -sI https://kr.makenov.com/products.html | head -1  (200, 한국어)
#          curl -sI https://makenov.com/ko/products.html | grep -i location  (→ kr)
#          curl -sI https://makenov.com/products.html | grep -i location     (→ vn)
#          curl -s  https://kr.makenov.com/robots.txt                         (Sitemap: https://kr.makenov.com/sitemap.xml)
