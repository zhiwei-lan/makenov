# MAKENOV API — 환경 설정 템플릿 (가이드라인 §8)
# 복사해서 .env 로 만들고 실제 값을 넣는다. .env 는 저장소에 올리지 않는다.

CI_ENVIRONMENT = production
app.baseURL = 'https://api.도메인.com/'

database.default.hostname = localhost
database.default.database = makenov
database.default.username = DB사용자
database.default.password = DB비밀번호
database.default.DBDriver = MySQLi
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# CSRF — API 는 토큰 인증이라 끄고, 서버 렌더링 폼을 만들면 그때 켠다
security.csrfProtection = 'cookie'

# ── MAKENOV 전용 ──────────────────────────────────────────
# 공개 토큰: Supabase anon key 자리. openssl rand -hex 32 로 생성 권장.
# 프론트 config.js 의 MK_SUPABASE_ANON 에 같은 값을 넣는다.
makenov.publicToken = 'CHANGE_ME_PUBLIC_TOKEN'

# 국세청 사업자 상태조회 키 (공공데이터포털에서 발급).
# 비워두면 체크섬 검증만으로 통과 처리된다.
makenov.ntsKey = ''
