# MAKENOV API — 生产环境配置 (1Panel 服务器)
# 上传后必须在服务器上编辑此文件：
#   1) 数据库用户名/密码改成 1Panel 里创建的值
#   2) 如需更换 publicToken，同时改 public/assets/js/config.js 里的 MK_SUPABASE_ANON

CI_ENVIRONMENT = production
app.baseURL = 'https://makenov.vigo.co.kr/'

database.default.hostname = 127.0.0.1
database.default.database = makenov
database.default.username = makenov          # ← 改成 1Panel 创建的数据库用户名
database.default.password = CHANGE_ME        # ← 改成 1Panel 设置的密码
database.default.DBDriver = MySQLi
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# CSRF — API 是 token 认证，关闭
security.csrfProtection = 'cookie'

# ── MAKENOV 专用 ──────────────────────────────────────────
# 公开令牌（对应 Supabase anon key），与 public/assets/js/config.js 的 MK_SUPABASE_ANON 一致
makenov.publicToken = 'c588966176574f36d29d4dc71fed1485bb1626adc5f794ff5e1409da69815080'

# 国税厅事业者状态查询 API 密钥（可选，留空则仅校验和通过）
makenov.ntsKey = ''
