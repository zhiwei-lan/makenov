# MAKENOV — 1Panel Nginx 站点配置示例（单目录版）
# 站点根目录: /www/wwwroot/makenov/public
# 前端页面与 API 共用同一目录：静态文件直接返回，API 路径(/rest/v1/* 等)自动进入 PHP → CI4
# 1Panel 添加网站：类型选 PHP，域名 makenov.vigo.co.kr，运行目录设为 public
# 然后把下面内容替换站点配置的 server{} 部分，路径按实际部署位置修改

server {
    listen 80;
    server_name makenov.vigo.co.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name makenov.vigo.co.kr;

    # 1Panel 网站设置里启用 Let's Encrypt 后自动生成，路径按实际调整
    ssl_certificate     /www/server/panel/vhost/cert/makenov.vigo.co.kr/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/makenov.vigo.co.kr/privkey.pem;

    root  /www/wwwroot/makenov/public;
    index index.html index.php;

    # 关键一行：静态文件存在就直接返回；否则交给 CI4(index.php)
    # /rest/v1/*、/auth/v1/*、/functions/v1/*、/storage/v1/* 都会自动进入 PHP → CI4 路由
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP 执行（端口/socket 与 1Panel 的 PHP 版本一致，默认 unix:/tmp/php-cgi-82.sock）
    location ~ [^/]\.php(/|$) {
        fastcgi_pass unix:/tmp/php-cgi-82.sock;   # 或 127.0.0.1:9000
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # 上传的图片（后端 Storage 写入 public/uploads/）
    location /uploads/ {
        expires 30d;
    }
}
